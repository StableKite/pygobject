+static void
+release_type_name (char *type_name)
+{
+    Py_BEGIN_ALLOW_THREADS;
+    g_mutex_lock (&type_name_lock);
+    g_hash_table_remove (pending_type_names, type_name);
+    g_mutex_unlock (&type_name_lock);
+    Py_END_ALLOW_THREADS;
+    g_free (type_name);
+}
