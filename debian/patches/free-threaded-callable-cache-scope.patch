Description: Fix callable-cache critical-section scope
Author: Robolightning <irobolightning@gmail.com>
Origin: https://gitlab.gnome.org/GNOME/pygobject/-/merge_requests/578
Forwarded: https://gitlab.gnome.org/GNOME/pygobject/-/merge_requests/578
Last-Update: 2026-11-12

diff --git a/gi/pygi-info.c b/gi/pygi-info.c
index 7d0f8826..bd462418 100644
--- a/gi/pygi-info.c
+++ b/gi/pygi-info.c
@@ -744,35 +744,34 @@ pygi_callable_info_get_cache (PyGICallableInfo *self)
     Py_BEGIN_CRITICAL_SECTION (self);
 #endif
 
-    if (self->cache != NULL) {
-#ifdef Py_GIL_DISABLED
-        Py_END_CRITICAL_SECTION ();
-#endif
-        return self->cache;
-    }
-
-    if (GI_IS_FUNCTION_INFO (info)) {
-        GIFunctionInfoFlags flags;
-
-        flags = gi_function_info_get_flags (GI_FUNCTION_INFO (info));
-
-        if (flags & GI_FUNCTION_IS_CONSTRUCTOR) {
-            function_cache =
-                pygi_constructor_cache_new (GI_CALLABLE_INFO (info));
-        } else if (flags & GI_FUNCTION_IS_METHOD) {
-            function_cache = pygi_method_cache_new (GI_CALLABLE_INFO (info));
+    if (self->cache == NULL) {
+        if (GI_IS_FUNCTION_INFO (info)) {
+            GIFunctionInfoFlags flags;
+
+            flags = gi_function_info_get_flags (GI_FUNCTION_INFO (info));
+
+            if (flags & GI_FUNCTION_IS_CONSTRUCTOR) {
+                function_cache =
+                    pygi_constructor_cache_new (GI_CALLABLE_INFO (info));
+            } else if (flags & GI_FUNCTION_IS_METHOD) {
+                function_cache =
+                    pygi_method_cache_new (GI_CALLABLE_INFO (info));
+            } else {
+                function_cache =
+                    pygi_function_cache_new (GI_CALLABLE_INFO (info));
+            }
+        } else if (GI_IS_VFUNC_INFO (info)) {
+            function_cache = pygi_vfunc_cache_new (GI_CALLABLE_INFO (info));
+        } else if (GI_IS_CALLBACK_INFO (info)) {
+            g_error ("Cannot invoke callback types");
         } else {
-            function_cache = pygi_function_cache_new (GI_CALLABLE_INFO (info));
+            function_cache = pygi_method_cache_new (GI_CALLABLE_INFO (info));
         }
-    } else if (GI_IS_VFUNC_INFO (info)) {
-        function_cache = pygi_vfunc_cache_new (GI_CALLABLE_INFO (info));
-    } else if (GI_IS_CALLBACK_INFO (info)) {
-        g_error ("Cannot invoke callback types");
-    } else {
-        function_cache = pygi_method_cache_new (GI_CALLABLE_INFO (info));
+
+        self->cache = function_cache;
     }
 
-    self->cache = function_cache;
+    function_cache = self->cache;
 
 #ifdef Py_GIL_DISABLED
     Py_END_CRITICAL_SECTION ();
